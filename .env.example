# ── Servicio de Agentes (FastAPI) ───────────────────────────────
# Copia este archivo a `.env` y ajusta los valores.

# URLs base de los microservicios Node (incluyen el prefijo del servicio,
# p.ej. .../calendar/api y .../sessions/api)
CALENDAR_SERVICE_URL=http://localhost:4001
SESSIONS_SERVICE_URL=http://localhost:4002

# Header obligatorio en ambos servicios: coaching | mentoring
APP_ID=coaching

# Si está en true, los clientes devuelven datos simulados (sin red).
# Útil para desarrollo y tests mientras no estén cableados los servicios reales.
USE_STUB_CLIENTS=true

# Persistencia (MongoDB). Pon aquí tu connection string. Si la dejas vacía,
# el servicio funciona igual pero NO guarda las auditorías.
MONGODB_URI=
MONGODB_DB=coaching_audit

# Nexus API (coaching): de aquí sale el timezone del coach.
NEXUS_API_URL=

# Nylas: para detectar conexiones de calendario rotas. La key es secreto.
NYLAS_API_KEY=
NYLAS_API_URI=https://api.us.nylas.com/

# Job programado (auditoría automática de todos los coaches)
SCHEDULER_ENABLED=true
AUDIT_INTERVAL_MINUTES=60
AUDIT_FUTURE_ONLY=true
AUDIT_MAX_CONCURRENCY=5

# Reglas de negocio (configurables)
MIN_SESSION_MINUTES=15
MAX_SESSION_MINUTES=120
MAX_SESSIONS_PER_DAY=8
BUFFER_MINUTES=10
MIN_LEAD_TIME_MINUTES=60

# Timeout para llamadas HTTP a los servicios (segundos)
HTTP_TIMEOUT_SECONDS=5
