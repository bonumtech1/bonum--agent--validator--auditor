# Config de PROD para el contenedor (el workflow la inyecta como environment).
# NO poner secretos aquí: MONGODB_URI se inyecta desde GitHub Secrets en el workflow.

PORT=8000
USE_STUB_CLIENTS=false
APP_ID=coaching

CALENDAR_SERVICE_URL=https://service-calendar-production.tclik5ai2vodi.us-east-1.cs.amazonlightsail.com/calendar/api
SESSIONS_SERVICE_URL=https://container-sessions-production.tclik5ai2vodi.us-east-1.cs.amazonlightsail.com/sessions/api
NEXUS_API_URL=https://bonum-nexus-api-prod.tclik5ai2vodi.us-east-1.cs.amazonlightsail.com/api

MONGODB_DB=coaching_audit

# Job programado
SCHEDULER_ENABLED=true
AUDIT_INTERVAL_MINUTES=60
AUDIT_FUTURE_ONLY=true
AUDIT_CALENDAR_HEALTH=true
