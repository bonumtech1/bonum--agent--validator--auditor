# Config de DEV para el contenedor (el workflow la inyecta como environment).
# NO poner secretos aquí: MONGODB_URI se inyecta desde GitHub Secrets en el workflow.

PORT=8000
USE_STUB_CLIENTS=false
APP_ID=coaching

CALENDAR_SERVICE_URL=https://container-service-calendar-development.tclik5ai2vodi.us-east-1.cs.amazonlightsail.com/calendar/api
SESSIONS_SERVICE_URL=https://container-sessions-development.tclik5ai2vodi.us-east-1.cs.amazonlightsail.com/sessions/api
NEXUS_API_URL=https://bonum-nexus-api-dev.tclik5ai2vodi.us-east-1.cs.amazonlightsail.com/api

MONGODB_DB=coaching_audit

# Nylas (la API key se inyecta desde GitHub Secrets, no va aquí)
NYLAS_API_URI=https://api.us.nylas.com/

# Job programado
SCHEDULER_ENABLED=true
AUDIT_INTERVAL_MINUTES=60
AUDIT_FUTURE_ONLY=true
AUDIT_CALENDAR_HEALTH=true
